{
  "branches": ["main"],
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    [
      "@semantic-release/release-notes-generator",
      { "preset": "conventionalcommits" }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "scripts/build-release.sh ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/mindflayer-keypad-*-server-firmware.tar.gz",
            "label": "Server-ready signed keypad firmware"
          },
          {
            "path": "dist/mindflayer-keypad-*-serial-install.tar.gz",
            "label": "Authenticated initial serial installation bundle"
          }
        ]
      }
    ]
  ]
}
